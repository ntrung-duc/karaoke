# Optional: copy to .env and run node --env-file=.env server.mjs
# npm start uses environment variables already set in the shell.
PORT=4173
HOST=0.0.0.0
# Server-only YouTube Data API v3 key, restricted to that API in Google Cloud.
# YOUTUBE_API_KEY=your-youtube-api-key
# Required on Vercel; use a Redis TCP URL with Pub/Sub support.
# REDIS_URL=rediss://default:your-password@your-redis-host:6379
# REDIS_PREFIX=karaoke:production
# TURN_URL=turn:your-turn-host:3478
# TURN_USER=your-user
# TURN_PASSWORD=your-password

# LiveKit SFU: all three values enable server-distributed singer audio.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your-api-key
# LIVEKIT_API_SECRET=your-api-secret
